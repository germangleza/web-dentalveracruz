---
/** Layout base: HTML semántico + SEO + schemas globales. Todas las páginas lo usan. */
import SEO from '../components/SEO.astro';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import { getCollection } from 'astro:content';
import { SITE, whatsappUrl, telUrl } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** true = la página maneja su propio ancho (secciones a todo lo ancho, p. ej. el inicio) */
  fullWidth?: boolean;
}
const { fullWidth = false, ...seoProps } = Astro.props;
const props = { ...seoProps, noindex: SITE.prelaunch || seoProps.noindex };
const hasPosts = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
const b = SITE.business;
const reg = SITE.regulatory;
const socials = [
  SITE.socials.facebook && { name: 'Facebook', url: `https://facebook.com/${SITE.socials.facebook}` },
  SITE.socials.instagram && { name: 'Instagram', url: `https://instagram.com/${SITE.socials.instagram}` },
  SITE.socials.tiktok && { name: 'TikTok', url: `https://tiktok.com/@${SITE.socials.tiktok}` },
].filter(Boolean) as { name: string; url: string }[];
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet" />
    <SEO {...props} />
    <OrganizationSchema />
    <WebSiteSchema />
    {SITE.analytics.plausibleDomain && (
      <script defer data-domain={SITE.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <img src={SITE.logo} alt={SITE.name} width="128" height="52" />
        </a>
        <nav class="nav" aria-label="Principal">
          <a href="/#general">Odontología general</a>
          <a href="/#especialidades">Especialidades</a>
          <a href="/#preguntas">Preguntas frecuentes</a>
          {SITE.medicalTeam.length > 0 && <a href="/equipo">Equipo</a>}
          {hasPosts && <a href="/blog">Blog</a>}
          <a href="/#ubicacion">Ubicación</a>
          <a href={whatsappUrl()} class="btn btn-primary" target="_blank" rel="noopener" data-track="whatsapp-header">Agendar cita</a>
        </nav>
      </div>
    </header>

    <main>
      {fullWidth ? <slot /> : <div class="page"><slot /></div>}
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="stack">
          <img class="footer-logo" src={SITE.logoWhite} alt={SITE.name} width="137" height="56" loading="lazy" />
          <address>
            {b.address.street}, {b.address.city}, {b.address.state} {b.address.zip}<br />
            <a href={telUrl()}>{b.phone}</a>
          </address>
          {reg.sanitaryResponsible && <span>Responsable sanitario: {reg.sanitaryResponsible}</span>}
          {reg.advertisingPermit && <span>Aviso de publicidad COFEPRIS: {reg.advertisingPermit}</span>}
          <span>© {new Date().getFullYear()} {SITE.name}{b.legalName && ` · ${b.legalName}`}</span>
        </div>
        <div class="footer-links">
          <a href="/aviso-de-privacidad">Aviso de privacidad</a>
          <a href={SITE.maps.placeUrl} target="_blank" rel="noopener">Google Maps</a>
          {socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.name}</a>)}
        </div>
      </div>
    </footer>

    <a class="wa-float" href={whatsappUrl()} target="_blank" rel="noopener" aria-label="Agendar por WhatsApp" data-track="whatsapp-flotante">
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2s.2-1.1.1-1.2-.2-.2-.5-.3Z"/></svg>
    </a>
  </body>
</html>
